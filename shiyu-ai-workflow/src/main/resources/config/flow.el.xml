<?xml version="1.0" encoding="UTF-8"?>
<flow>
    <!--
    学习流程链 learningChain
    流程：检查前置知识 → 加载资源 → AI 讲解 → 练习 → 评分 → 更新掌握度
    -->
    <chain name="learningChain">
        THEN(
            checkKnowledgeCmp,
            loadResourceCmp,
            teacherCmp,
            practiceCmp,
            scoreCmp,
            updateMasteryCmp
        );
    </chain>

    <!--
    复习流程链 reviewChain
    流程：获取复习任务 → 出题 → 评分 → 更新掌握度
    -->
    <chain name="reviewChain">
        THEN(
            loadReviewTaskCmp,
            generateReviewQuestionsCmp,
            reviewScoreCmp,
            updateReviewMasteryCmp
        );
    </chain>

    <!--
    考试流程链 examChain
    流程：组卷 → 答题（待外部输入） → 自动评分 → 分析
    -->
    <chain name="examChain">
        THEN(
            generateExamCmp,
            scoreExamCmp,
            analyzeExamCmp
        );
    </chain>
</flow>
