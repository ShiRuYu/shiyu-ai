### ============================================================
### 教育业务域 API
### 基础 URL: http://localhost:9000
### 种子数据: 学科(5)、教材(5)、章节(10)、学生(2)、教师(1)
### 课程(3)、资源(6)、题目(10)、考试(2)、能力值(12)
### 学习记录(17)、复习任务(11)、学习计划(2)、错题本(4)
### ============================================================

@baseUrl = http://localhost:9000

### ============================================================
### 0. 【必须先执行】登录获取 Token
###    执行后 {{Login.response.body.$.data.accessToken}} 即为后续请求的 Bearer Token
### ============================================================

# @name Login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "vben",
  "password": "123456",
  "captchaKey": "",
  "captcha": ""
}


### ============================================================
### 学科 API
### ============================================================

### 1. 获取学科列表
GET {{baseUrl}}/api/v1/subject
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 2. 获取学科详情
GET {{baseUrl}}/api/v1/subject/1
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 3. 按编码获取学科
GET {{baseUrl}}/api/v1/subject/code/MATH
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 4. 按学段获取学科
GET {{baseUrl}}/api/v1/subject/grade-level/K3
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### ============================================================
### 教材 API
### ============================================================

### 5. 获取教材列表
GET {{baseUrl}}/api/v1/textbook
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 6. 获取教材详情
GET {{baseUrl}}/api/v1/textbook/1
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 7. 按学科和年级查询教材
GET {{baseUrl}}/api/v1/textbook/subject/MATH/grade/7
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### ============================================================
### 章节 API
### ============================================================

### 8. 获取章节详情
GET {{baseUrl}}/api/v1/chapter/1
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 9. 按教材查询章节
GET {{baseUrl}}/api/v1/chapter/textbook/1
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 10. 获取章节树
GET {{baseUrl}}/api/v1/chapter/textbook/1/tree
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### ============================================================
### 课程 API
### ============================================================

### 11. 获取课程列表
GET {{baseUrl}}/api/v1/course
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 12. 获取课程详情
GET {{baseUrl}}/api/v1/course/1
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 13. 按学科查询课程
GET {{baseUrl}}/api/v1/course/subject/MATH
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 14. 按年级查询课程
GET {{baseUrl}}/api/v1/course/grade/7
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### ============================================================
### 题目 (Question) API
### ============================================================

### 15. 获取题目详情
GET {{baseUrl}}/api/v1/question/1
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 16. 按学科和年级查询题目
GET {{baseUrl}}/api/v1/question/subject/MATH/grade/7
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 17. 按难度查询题目
GET {{baseUrl}}/api/v1/question/difficulty/1
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 18. 按类型查询题目
GET {{baseUrl}}/api/v1/question/type/CHOICE
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### ============================================================
### 错题本 API
### ============================================================

### 19. 获取学生错题列表
GET {{baseUrl}}/api/v1/wrong-question/student/1
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### ============================================================
### 考试 API
### ============================================================

### 20. 获取考试详情
GET {{baseUrl}}/api/v1/exam/1
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 21. 按学科查询考试
GET {{baseUrl}}/api/v1/exam/subject/MATH
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 22. 按教师查询考试
GET {{baseUrl}}/api/v1/exam/teacher/1
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### ============================================================
### 复习任务 API
### ============================================================

### 23. 获取复习任务详情
GET {{baseUrl}}/api/v1/review/1
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 24. 获取学生今日复习任务
GET {{baseUrl}}/api/v1/review/today/1
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 25. 按学生和状态查询复习任务
GET {{baseUrl}}/api/v1/review/student/1/status/PENDING
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 26. 完成复习任务
PUT {{baseUrl}}/api/v1/review/1/complete
Content-Type: application/json
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

{
  "resultScore": 85,
  "status": "COMPLETED"
}

### ============================================================
### 学习计划 API
### ============================================================

### 27. 获取计划详情
GET {{baseUrl}}/api/v1/plan/1
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 28. 查询学生所有计划
GET {{baseUrl}}/api/v1/plan/student/1
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 29. 查询学生活跃计划
GET {{baseUrl}}/api/v1/plan/student/1/active
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### ============================================================
### 学习分析 API
### ============================================================

### 30. 获取学生学习记录
GET {{baseUrl}}/api/v1/analytics/records/student/1
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 31. 获取学生某知识点的学习记录
GET {{baseUrl}}/api/v1/analytics/records/student/1/knowledge/5
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### ============================================================
### 学习资源 API
### ============================================================

### 32. 获取资源列表
GET {{baseUrl}}/api/v1/resource
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 33. 获取资源详情
GET {{baseUrl}}/api/v1/resource/1
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 34. 按学科查询资源
GET {{baseUrl}}/api/v1/resource/subject/MATH
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 35. 按类型查询资源
GET {{baseUrl}}/api/v1/resource/type/VIDEO
Authorization: Bearer {{Login.response.body.$.data.accessToken}}
