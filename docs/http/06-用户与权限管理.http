### ============================================================
### 用户 & 权限管理 API
### 基础 URL: http://localhost:9000
### 种子数据含默认用户：admin/admin123, vben/123456
### ============================================================

@baseUrl = http://localhost:9000

### ============================================================
### 0. 【必须先执行】登录获取 Token
###    执行后 {{Login.response.body.$.data.accessToken}} 即为后续请求的 Bearer Token
### ============================================================

# @name Login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "vben",
  "password": "123456",
  "captchaKey": "",
  "captcha": ""
}


### ============================================================
### 用户管理 API
### ============================================================

### 1. 获取当前用户信息
GET {{baseUrl}}/user/info
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 2. 分页查询用户
GET {{baseUrl}}/user?pageNum=1&pageSize=10
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 3. 创建用户
POST {{baseUrl}}/user
Content-Type: application/json
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

{
  "username": "zhangsan",
  "password": "123456",
  "nickName": "张三",
  "gender": 1,
  "email": "zhangsan@example.com",
  "status": "1"
}

### 4. 更新用户
PUT {{baseUrl}}/user/4
Content-Type: application/json
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

{
  "nickName": "张三（已更新）",
  "email": "zhangsan_new@example.com"
}

### 5. 删除用户
DELETE {{baseUrl}}/user/4
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 6. 重置用户密码
PUT {{baseUrl}}/user/4/reset-password
Content-Type: application/json
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

{
  "newPassword": "654321"
}

### 7. 启用/禁用用户
PUT {{baseUrl}}/user/4/status
Content-Type: application/json
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

{
  "status": "0"
}

### ============================================================
### 角色管理 API
### ============================================================

### 8. 分页查询角色
GET {{baseUrl}}/role/list?page=1&pageSize=10
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 9. 查询角色列表（下拉选择用）
GET {{baseUrl}}/role
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 10. 创建角色
POST {{baseUrl}}/role
Content-Type: application/json
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

{
  "code": "STUDENT",
  "name": "学生",
  "status": "1",
  "remark": "学生角色"
}

### 11. 更新角色
PUT {{baseUrl}}/role/1
Content-Type: application/json
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

{
  "code": "ADMIN",
  "name": "超级管理员",
  "status": "1"
}

### 12. 删除角色
DELETE {{baseUrl}}/role/1
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 13. 分配用户角色
PUT {{baseUrl}}/role/1/users
Content-Type: application/json
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

{
  "userIds": [1, 2]
}

### ============================================================
### 菜单管理 API
### ============================================================

### 14. 获取所有菜单
GET {{baseUrl}}/menu/all
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 15. 获取菜单列表
GET {{baseUrl}}/menu/list
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 16. 获取根菜单
GET {{baseUrl}}/menu/list/roots
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 17. 获取子菜单
GET {{baseUrl}}/menu/list/children/1
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 18. 获取菜单树
GET {{baseUrl}}/menu/tree
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 19. 获取角色权限树
GET {{baseUrl}}/menu/role/permissions/tree
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 20. 检查菜单名称是否存在
GET {{baseUrl}}/menu/name-exists?name=系统管理
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 21. 检查菜单路径是否存在
GET {{baseUrl}}/menu/path-exists?path=/system
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 22. 获取按钮列表
GET {{baseUrl}}/menu/button/1
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### ============================================================
### 租户管理 API
### ============================================================

### 23. 获取所有租户
GET {{baseUrl}}/tenant/all
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 24. 获取租户详情
GET {{baseUrl}}/tenant/1
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### ============================================================
### 工作空间 API
### ============================================================

### 25. 查询工作空间列表
GET {{baseUrl}}/workspace/list
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### ============================================================
### 字典管理 API
### ============================================================

### 26. 分页查询字典
GET {{baseUrl}}/dict/page?pageNum=1&pageSize=10
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 27. 按类型查询字典
GET {{baseUrl}}/dict/type/SYSTEM_CONFIG
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### ============================================================
### 时区 API
### ============================================================

### 28. 获取时区选项
GET {{baseUrl}}/timezone/getTimezoneOptions
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 29. 获取用户时区
GET {{baseUrl}}/timezone/getTimezone
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

### 30. 测试用户上下文信息
GET {{baseUrl}}/test/user-context/info
Authorization: Bearer {{Login.response.body.$.data.accessToken}}
