### ============================================================
### 认证中心 API — Auth / Captcha / User / Timezone / Upload
### 基础 URL: http://localhost:9000
### ============================================================

@baseUrl = http://localhost:9000

### ============================================================
### 1. 登录 (vben / 123456)
### POST {{baseUrl}}/api/auth/login
### ============================================================

# @name Login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ username:vben,password:123456}


### ============================================================
### 2. 获取权限标识列表
### GET {{baseUrl}}/api/auth/codes
### ============================================================

GET {{baseUrl}}/api/auth/codes
Authorization: Bearer {{Login.response.body.$.data.accessToken}}


### ============================================================
### 3. 获取验证码
### GET {{baseUrl}}/api/auth/captcha
### ============================================================

GET {{baseUrl}}/api/auth/captcha


### ============================================================
### 4. 切换角色
### PATCH {{baseUrl}}/api/auth/current-role
### ============================================================

PATCH {{baseUrl}}/api/auth/current-role
Content-Type: application/json
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

{roleId:1}


### ============================================================
### 5. 切换工作空间
### POST {{baseUrl}}/api/auth/switch-workspace
### ============================================================

POST {{baseUrl}}/api/auth/switch-workspace
Content-Type: application/json
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

{workspaceId:1,tenantId:1}


### ============================================================
### 6. 获取工作空间
### GET {{baseUrl}}/api/auth/workspaces
### ============================================================

GET {{baseUrl}}/api/auth/workspaces
Authorization: Bearer {{Login.response.body.$.data.accessToken}}


### ============================================================
### 7. 当前用户信息
### GET {{baseUrl}}/admin/user/info
### ============================================================

GET {{baseUrl}}/admin/user/info
Authorization: Bearer {{Login.response.body.$.data.accessToken}}


### ============================================================
### 8. 用户列表
### GET {{baseUrl}}/admin/user
### ============================================================

GET {{baseUrl}}/admin/user
Authorization: Bearer {{Login.response.body.$.data.accessToken}}


### ============================================================
### 9. 时区选项
### GET {{baseUrl}}/api/timezone/getTimezoneOptions
### ============================================================

GET {{baseUrl}}/api/timezone/getTimezoneOptions
Authorization: Bearer {{Login.response.body.$.data.accessToken}}


### ============================================================
### 10. 退出登录
### POST {{baseUrl}}/api/auth/logout
### ============================================================

POST {{baseUrl}}/api/auth/logout
Content-Type: application/json
Authorization: Bearer {{Login.response.body.$.data.accessToken}}

{}
