### ==========================================
### 字典管理 — Dictionary Management
### 路径前缀：/dict
### ==========================================

@baseUrl = http://localhost:9000

### ------------------- 字典分页列表 -------------------
### @name Get Dict List (Page)
GET {{baseUrl}}/dict/list?pageNo=1&pageSize=20 HTTP/1.1
Authorization: Bearer {{authToken}}

### ------------------- 按类型查询字典 -------------------
### @name Get Dict By Type
GET {{baseUrl}}/dict/type?dictType=sys_normal_disable HTTP/1.1
Authorization: Bearer {{authToken}}

### ------------------- 创建字典项 -------------------
### @name Create Dict
POST {{baseUrl}}/dict/create HTTP/1.1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "dictType": "sys_user_sex",
  "dictLabel": "男",
  "dictValue": "1",
  "dictSort": 1,
  "status": "1",
  "remark": "性别-男"
}

### ------------------- 更新字典项 -------------------
### @name Update Dict
POST {{baseUrl}}/dict/update?id=1 HTTP/1.1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "dictLabel": "女",
  "dictValue": "2",
  "dictSort": 2
}

### ------------------- 删除字典项 -------------------
### @name Delete Dict
POST {{baseUrl}}/dict/delete?id=1 HTTP/1.1
Authorization: Bearer {{authToken}}

### ------------------- 批量删除字典项 -------------------
### @name Delete Dicts Batch
POST {{baseUrl}}/dict/batch-delete HTTP/1.1
Authorization: Bearer {{authToken}}
Content-Type: application/json

[1, 2, 3]
