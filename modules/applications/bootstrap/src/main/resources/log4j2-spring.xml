<?xml version="1.0" encoding="UTF-8"?>
<Configuration monitorInterval="30" status="WARN">
    <Properties>
        <Property name="project">shiyu-ai</Property>
        <Property name="logDir">${sys:app.home:-.}/data/log</Property>
        <Property name="historyLogDir">${sys:app.home:-.}/data/log/history</Property>
        <Property name="splitSize">100MB</Property>
        <Property name="fileCount">30</Property>
        <Property name="pattern">%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{traceId}] %-5level %logger{50} - %msg%n</Property>
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${pattern}"/>
        </Console>

        <RollingFile name="commonDebug" fileName="${logDir}/debug.log"
                     filePattern="${historyLogDir}/${project}-debug-%d{yyyy-MM-dd}-%i.log">
            <Filters>
                <ThresholdFilter level="INFO" onMatch="DENY" onMismatch="NEUTRAL"/>
                <ThresholdFilter level="DEBUG" onMatch="ACCEPT" onMismatch="DENY"/>
            </Filters>
            <PatternLayout pattern="${pattern}"/>
            <Policies><TimeBasedTriggeringPolicy/><SizeBasedTriggeringPolicy size="${splitSize}"/></Policies>
            <DefaultRolloverStrategy max="${fileCount}"/>
        </RollingFile>
        <RollingFile name="commonInfo" fileName="${logDir}/info.log"
                     filePattern="${historyLogDir}/${project}-info-%d{yyyy-MM-dd}-%i.log">
            <Filters><ThresholdFilter level="INFO" onMatch="ACCEPT" onMismatch="DENY"/></Filters>
            <PatternLayout pattern="${pattern}"/>
            <Policies><TimeBasedTriggeringPolicy/><SizeBasedTriggeringPolicy size="${splitSize}"/></Policies>
            <DefaultRolloverStrategy max="${fileCount}"/>
        </RollingFile>
        <RollingFile name="commonWarn" fileName="${logDir}/warn.log"
                     filePattern="${historyLogDir}/${project}-warn-%d{yyyy-MM-dd}-%i.log">
            <Filters><ThresholdFilter level="WARN" onMatch="ACCEPT" onMismatch="DENY"/></Filters>
            <PatternLayout pattern="${pattern}"/>
            <Policies><TimeBasedTriggeringPolicy/><SizeBasedTriggeringPolicy size="${splitSize}"/></Policies>
            <DefaultRolloverStrategy max="${fileCount}"/>
        </RollingFile>
        <RollingFile name="errorFile" fileName="${logDir}/error.log"
                     filePattern="${historyLogDir}/${project}-error-%d{yyyy-MM-dd}-%i.log">
            <Filters><ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/></Filters>
            <PatternLayout pattern="${pattern}"/>
            <Policies><TimeBasedTriggeringPolicy/><SizeBasedTriggeringPolicy size="${splitSize}"/></Policies>
            <DefaultRolloverStrategy max="${fileCount}"/>
        </RollingFile>

        <RollingFile name="webFile" fileName="${logDir}/web.log"
                     filePattern="${historyLogDir}/${project}-web-%d{yyyy-MM-dd}-%i.log">
            <PatternLayout pattern="${pattern}"/>
            <Policies><TimeBasedTriggeringPolicy/><SizeBasedTriggeringPolicy size="${splitSize}"/></Policies>
            <DefaultRolloverStrategy max="${fileCount}"/>
        </RollingFile>
        <RollingFile name="auditFile" fileName="${logDir}/audit.log"
                     filePattern="${historyLogDir}/${project}-audit-%d{yyyy-MM-dd}-%i.log">
            <PatternLayout pattern="${pattern}"/>
            <Policies><TimeBasedTriggeringPolicy/><SizeBasedTriggeringPolicy size="${splitSize}"/></Policies>
            <DefaultRolloverStrategy max="${fileCount}"/>
        </RollingFile>
        <RollingFile name="securityFile" fileName="${logDir}/security.log"
                     filePattern="${historyLogDir}/${project}-security-%d{yyyy-MM-dd}-%i.log">
            <PatternLayout pattern="${pattern}"/>
            <Policies><TimeBasedTriggeringPolicy/><SizeBasedTriggeringPolicy size="${splitSize}"/></Policies>
            <DefaultRolloverStrategy max="${fileCount}"/>
        </RollingFile>
        <RollingFile name="aiFile" fileName="${logDir}/ai.log"
                     filePattern="${historyLogDir}/${project}-ai-%d{yyyy-MM-dd}-%i.log">
            <PatternLayout pattern="${pattern}"/>
            <Policies><TimeBasedTriggeringPolicy/><SizeBasedTriggeringPolicy size="${splitSize}"/></Policies>
            <DefaultRolloverStrategy max="${fileCount}"/>
        </RollingFile>
        <RollingFile name="toolFile" fileName="${logDir}/tool.log"
                     filePattern="${historyLogDir}/${project}-tool-%d{yyyy-MM-dd}-%i.log">
            <PatternLayout pattern="${pattern}"/>
            <Policies><TimeBasedTriggeringPolicy/><SizeBasedTriggeringPolicy size="${splitSize}"/></Policies>
            <DefaultRolloverStrategy max="${fileCount}"/>
        </RollingFile>
        <RollingFile name="knowledgeFile" fileName="${logDir}/knowledge.log"
                     filePattern="${historyLogDir}/${project}-knowledge-%d{yyyy-MM-dd}-%i.log">
            <PatternLayout pattern="${pattern}"/>
            <Policies><TimeBasedTriggeringPolicy/><SizeBasedTriggeringPolicy size="${splitSize}"/></Policies>
            <DefaultRolloverStrategy max="${fileCount}"/>
        </RollingFile>
        <RollingFile name="taskFile" fileName="${logDir}/task.log"
                     filePattern="${historyLogDir}/${project}-task-%d{yyyy-MM-dd}-%i.log">
            <PatternLayout pattern="${pattern}"/>
            <Policies><TimeBasedTriggeringPolicy/><SizeBasedTriggeringPolicy size="${splitSize}"/></Policies>
            <DefaultRolloverStrategy max="${fileCount}"/>
        </RollingFile>
        <RollingFile name="integrationFile" fileName="${logDir}/integration.log"
                     filePattern="${historyLogDir}/${project}-integration-%d{yyyy-MM-dd}-%i.log">
            <PatternLayout pattern="${pattern}"/>
            <Policies><TimeBasedTriggeringPolicy/><SizeBasedTriggeringPolicy size="${splitSize}"/></Policies>
            <DefaultRolloverStrategy max="${fileCount}"/>
        </RollingFile>
        <RollingFile name="performanceFile" fileName="${logDir}/performance.log"
                     filePattern="${historyLogDir}/${project}-performance-%d{yyyy-MM-dd}-%i.log">
            <PatternLayout pattern="${pattern}"/>
            <Policies><TimeBasedTriggeringPolicy/><SizeBasedTriggeringPolicy size="${splitSize}"/></Policies>
            <DefaultRolloverStrategy max="${fileCount}"/>
        </RollingFile>
        <RollingFile name="databaseFile" fileName="${logDir}/database.log"
                     filePattern="${historyLogDir}/${project}-database-%d{yyyy-MM-dd}-%i.log">
            <PatternLayout pattern="${pattern}"/>
            <Policies><TimeBasedTriggeringPolicy/><SizeBasedTriggeringPolicy size="${splitSize}"/></Policies>
            <DefaultRolloverStrategy max="${fileCount}"/>
        </RollingFile>
    </Appenders>

    <Loggers>
        <Logger name="com.shiyu" level="${spring:logging.level.com.shiyu:-INFO}" additivity="true">
            <AppenderRef ref="commonDebug" level="DEBUG"/>
            <AppenderRef ref="commonInfo" level="INFO"/>
            <AppenderRef ref="commonWarn" level="WARN"/>
            <AppenderRef ref="errorFile" level="ERROR"/>
        </Logger>

        <Logger name="com.shiyu.ai.web" level="INFO" additivity="false"><AppenderRef ref="webFile"/></Logger>
        <Logger name="com.shiyu.ai.auth" level="INFO" additivity="false"><AppenderRef ref="securityFile"/></Logger>
        <Logger name="com.shiyu.ai.agent" level="INFO" additivity="false"><AppenderRef ref="commonInfo"/></Logger>
        <Logger name="com.shiyu.ai.model" level="INFO" additivity="false"><AppenderRef ref="aiFile"/></Logger>
        <Logger name="com.shiyu.ai.tool" level="INFO" additivity="false"><AppenderRef ref="toolFile"/></Logger>
        <Logger name="com.shiyu.ai.plugin" level="INFO" additivity="false"><AppenderRef ref="toolFile"/></Logger>
        <Logger name="com.shiyu.ai.knowledge" level="INFO" additivity="false"><AppenderRef ref="knowledgeFile"/></Logger>
        <Logger name="com.shiyu.ai.common.mybatis" level="INFO" additivity="false"><AppenderRef ref="databaseFile"/></Logger>

        <Logger name="WEB_LOGGER" level="INFO" additivity="false"><AppenderRef ref="webFile"/></Logger>
        <Logger name="AUDIT_LOGGER" level="INFO" additivity="false"><AppenderRef ref="auditFile"/></Logger>
        <Logger name="SECURITY_LOGGER" level="INFO" additivity="false"><AppenderRef ref="securityFile"/></Logger>
        <Logger name="AI_LOGGER" level="INFO" additivity="false"><AppenderRef ref="aiFile"/></Logger>
        <Logger name="TOOL_LOGGER" level="INFO" additivity="false"><AppenderRef ref="toolFile"/></Logger>
        <Logger name="KNOWLEDGE_LOGGER" level="INFO" additivity="false"><AppenderRef ref="knowledgeFile"/></Logger>
        <Logger name="TASK_LOGGER" level="INFO" additivity="false"><AppenderRef ref="taskFile"/></Logger>
        <Logger name="INTEGRATION_LOGGER" level="INFO" additivity="false"><AppenderRef ref="integrationFile"/></Logger>
        <Logger name="PERFORMANCE_LOGGER" level="INFO" additivity="false"><AppenderRef ref="performanceFile"/></Logger>
        <Logger name="DATABASE_LOGGER" level="INFO" additivity="false"><AppenderRef ref="databaseFile"/></Logger>
        <Logger name="ERROR_LOGGER" level="ERROR" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="errorFile"/>
        </Logger>
        <Logger name="SYSTEM_LOGGER" level="INFO" additivity="false"><AppenderRef ref="Console"/><AppenderRef ref="commonInfo"/></Logger>
        <Logger name="BUSINESS_LOGGER" level="INFO" additivity="false"><AppenderRef ref="Console"/><AppenderRef ref="commonInfo"/></Logger>
        <Logger name="COMMON_LOGGER" level="INFO" additivity="false"><AppenderRef ref="Console"/><AppenderRef ref="commonInfo"/><AppenderRef ref="commonWarn"/><AppenderRef ref="errorFile"/></Logger>
        <Root level="INFO"><AppenderRef ref="Console"/></Root>
    </Loggers>
</Configuration>
