<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.shiyu.ai</groupId>
        <artifactId>shiyu-ai</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>shiyu-ai-bootstrap</artifactId>
    <name>shiyu-ai-bootstrap</name>
    <description>Bootstrap startup module</description>

    <dependencies>
        <dependency>
            <groupId>com.shiyu.ai</groupId>
            <artifactId>shiyu-ai-auth</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shiyu.ai</groupId>
            <artifactId>shiyu-ai-record</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shiyu.ai</groupId>
            <artifactId>shiyu-ai-education</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shiyu.ai</groupId>
            <artifactId>shiyu-ai-dal</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shiyu.ai</groupId>
            <artifactId>shiyu-ai-agent</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shiyu.ai</groupId>
            <artifactId>shiyu-ai-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shiyu.ai</groupId>
            <artifactId>shiyu-ai-memory</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shiyu.ai</groupId>
            <artifactId>shiyu-ai-rag</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shiyu.ai</groupId>
            <artifactId>shiyu-ai-mcp</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shiyu.ai</groupId>
            <artifactId>shiyu-ai-knowledge</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shiyu.ai</groupId>
            <artifactId>shiyu-common-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shiyu.ai</groupId>
            <artifactId>shiyu-common-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-h2console</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <artifactId>spring-boot-starter</artifactId>
                    <groupId>org.springframework.boot</groupId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.bsc.langgraph4j</groupId>
            <artifactId>langgraph4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.bsc.langgraph4j</groupId>
            <artifactId>langgraph4j-langchain4j</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-reactor</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-ollama</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot4-starter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <mainClass>com.shiyu.ai.bootstrap.ShiyuBootstrapApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
